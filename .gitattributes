# Normalize all text files to LF in the repository.
# Prevents CRLF/LF churn when editing from Windows (e.g. the \wsl.localhost mount).
* text=auto eol=lf

# Explicitly treat common binary assets as binary (never touch their bytes).
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
